# Environment configuration
# Copy this file to .env and fill in your values

# Required: bcrypt hash of your password
# Generate with: htpasswd -nBC 10 "" | tr -d ':\n' | sed 's/$2y/$2a/'
AUTH_PASSWORD_HASH=

# Required: Random session secret (32+ bytes recommended)
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: Session expiry duration (default: 24h)
SESSION_EXPIRY=24h

# OpenCode API keys (set whichever you need)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=